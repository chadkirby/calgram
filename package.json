{
  "name": "calgram",
  "version": "0.0.133",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "jazz:generate": "jazz-tools generate --schema-dir jazz",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format-and-lint": "pnpm format:check && pnpm lint",
    "format-and-lint:fix": "pnpm format && pnpm lint:fix"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "cojson": "0.15.13",
    "cojson-transport-ws": "0.15.13",
    "jazz-classic": "npm:jazz-tools@0.15.13",
    "jazz-tools": "2.0.0-beta.5",
    "lucide-react": "^1.79.0",
    "luxon": "^3.7.2",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.11.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "globals": "^17.14.0",
    "is-ci": "^4.1.0",
    "jsdom": "^31.0.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26",
    "npm": "use pnpm",
    "pnpm": ">=12",
    "yarn": "use pnpm"
  }
}
